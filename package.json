{
  "name": "meu-n8n-backend",
  "version": "1.0.0",
  "description": "Ecossistema Completo: Backend Node.js + Frontend Vue.js",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "build": "tsup src/server.ts --format cjs --clean --external ws --external zod",
    "start": "node dist/server.js",
    "deploy:vm": "git pull origin main && npm install && npm run build && pm2 flush && pm2 restart jarvis --update-env && pm2 restart jarvis-frontend && pm2 save"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "node-fetch": "^3.3.2",
    "openai": "^7.37.0",
    "pg": "^8.23.1",
    "ssh2": "^1.15.0",
    "three": "^0.186.1",
    "vue": "^3.4.21",
    "ws": "^8.22.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "tsup": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.1.5",
    "vue-tsc": "^2.0.6"
  }
}